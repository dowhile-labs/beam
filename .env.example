# Redis connection string. For local docker-compose, this is set automatically.
# For Upstash, use the rediss:// TLS URL from your Upstash dashboard.
REDIS_URL=redis://redis:6379

# 32-byte (64 hex char) key used for AES-256-GCM encryption at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Public web viewer origin, used to build shareable URLs in API responses.
BEAM_WEB_ORIGIN=http://localhost:3001

# API server port
PORT=3000

# --- packages/mcp ---

# Beam API base URL the MCP server proxies to.
BEAM_API_URL=https://beam.dowhilelabs.dev

# MCP server port (separate from the API's PORT above when run together)
# PORT=3100
