{
  "name": "beam",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev:api": "pnpm --filter @dowhilelabs/api dev",
    "build:api": "pnpm --filter @dowhilelabs/api build",
    "start:api": "pnpm --filter @dowhilelabs/api start",
    "dev:cli": "pnpm --filter @dowhilelabs/beam dev",
    "build:cli": "pnpm --filter @dowhilelabs/beam build",
    "start:cli": "pnpm --filter @dowhilelabs/beam start",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.13.0"
  }
}
